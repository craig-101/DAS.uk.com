<%- include('partials/head', { title: '' }) %>
<header class="brand">
  <a class="brand__link" href="https://das.uk.com" target="_blank" rel="noopener" aria-label="Difficult Airway Society website (opens in a new tab)"><img class="brand__logo" src="/img/das-logo.png" alt="Difficult Airway Society" width="44" height="44"></a>
  <div>
    <div class="brand__name"><%= app.name %></div>
    <div class="brand__tag"><%= app.tagline %></div>
    <div class="brand__credit"><%= app.credit %></div>
  </div>
  <button class="brand__install" type="button" data-install aria-label="Add to desktop" title="Add to desktop">
    <%- include('partials/icon', { name: 'add-desktop' }) %>
  </button>
</header>
<%- include('partials/install-sheet') %>

<form class="searchbox" action="/search" method="get" role="search">
  <%- include('partials/icon', { name: 'search' }) %>
  <input type="search" name="q" placeholder="Search guidelines & teaching…" aria-label="Search guidelines and teaching" autocomplete="off">
</form>

<main class="screen">
  <a class="hero" href="/whats-new">
    <div class="hero__meta"><span class="chip chip--onblue">DAS 2025</span><span class="pill pill--new">New</span></div>
    <h2 class="hero__title"><%= whatsNew.title %></h2>
    <p class="hero__body">Key changes from the previous guideline — videolaryngoscopy first, standardised eFONA & more.</p>
    <span class="hero__cta">Read the summary <%- include('partials/icon', { name: 'chevron-right', className: 'icon--sm' }) %></span>
  </a>

  <h3 class="eyebrow">Collections</h3>
  <div class="stack">
    <% collections.forEach(c => { %>
      <a class="collection" href="/collections/<%= c.id %>" style="--accent:<%= c.accent %>">
        <div class="collection__strip">
          <% c.docs.slice(0, 4).forEach(d => { %>
            <div class="collection__thumb<%= d.orientation === 'portrait' ? ' is-portrait' : '' %>"><img src="<%= d.thumb %>" alt="" loading="lazy"></div>
          <% }) %>
        </div>
        <div class="collection__row">
          <div class="collection__text">
            <div class="collection__title"><%= c.title %></div>
            <div class="collection__sub"><%= c.subtitle %></div>
          </div>
          <div class="collection__side">
            <span class="chip"><%= c.tag %></span>
            <span class="collection__count"><%= c.docs.length %> items</span>
          </div>
          <%- include('partials/icon', { name: 'chevron-right', className: 'icon--muted' }) %>
        </div>
      </a>
    <% }) %>
  </div>

  <h3 class="eyebrow">Browse by type</h3>
  <div class="tiles">
    <% typeTiles.forEach(t => { %>
      <a class="tile" href="/types/<%= t.id %>">
        <span class="tile__icon" style="color:<%= t.color %>"><%- include('partials/icon', { name: t.icon }) %></span>
        <span class="tile__title"><%= t.plural %></span>
        <span class="tile__count"><%= t.count %> item<%= t.count === 1 ? '' : 's' %></span>
      </a>
    <% }) %>
  </div>

  <p class="disclaimer"><%- include('partials/icon', { name: 'alert', className: 'icon--sm' }) %><%= app.disclaimer %></p>
</main>
<%- include('partials/foot') %>
